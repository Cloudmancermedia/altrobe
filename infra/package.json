{
  "name": "altrobe-infra",
  "private": true,
  "description": "AWS infrastructure for the hosted Altrobe site (AWS CDK). See docs/deployment.md.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth --quiet",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "synth:offline": "CDK_DEFAULT_ACCOUNT=123456789012 CDK_OUTDIR=cdk.out tsx src/app.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "aws-cdk": "2.1145.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.2"
  }
}
